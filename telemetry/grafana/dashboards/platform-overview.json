{
  "title": "OpenThai Platform — ภาพรวมทั้ง 12 หมวด",
  "uid": "openthai-platform-v1",
  "tags": ["platform", "openthai", "overview"],
  "timezone": "Asia/Bangkok",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active Users (24h)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "count(count by (user_id) (http_requests_total{user_id!=''}[24h]))" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "green", "mode": "fixed" } }}
    },
    {
      "id": 2, "type": "stat", "title": "API Requests (1m)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) * 60" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" }}
    },
    {
      "id": 3, "type": "stat", "title": "Revenue Today (THB)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(ledger_revenue_daily_total)" }],
      "fieldConfig": { "defaults": { "unit": "currencyTHB" }}
    },
    {
      "id": 4, "type": "stat", "title": "Affiliate Commissions (THB)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(affiliate_commission_total{period='today'})" }],
      "fieldConfig": { "defaults": { "unit": "currencyTHB" }}
    },
    {
      "id": 5, "type": "stat", "title": "PCR Verifications (24h)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(increase(xades_verification_total[24h]))" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "blue", "mode": "fixed" } }}
    },
    {
      "id": 6, "type": "stat", "title": "Security Events (1h)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(increase(auth_failures_total[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":10},{"color":"red","value":50}] }
      }}
    },
    {
      "id": 7, "type": "table", "title": "สถานะ 12 หมวดบริการ",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}", "instant": true }],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "job": "หมวด", "Value": "สถานะ" } } }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Request Rate by User Group (6h)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(http_requests_total{user_group='producer'}[5m])", "legendFormat": "กลุ่ม 1 ผู้ผลิต" },
        { "expr": "rate(http_requests_total{user_group='intermediary'}[5m])", "legendFormat": "กลุ่ม 2 คนกลาง" },
        { "expr": "rate(http_requests_total{user_group='consumer'}[5m])", "legendFormat": "กลุ่ม 4 ผู้บริโภค" },
        { "expr": "rate(http_requests_total{user_group='professional'}[5m])", "legendFormat": "กลุ่ม 6 วิชาชีพ" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Infrastructure Health (6h)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "100 - (avg(irate(node_cpu_seconds_total{mode='idle'}[5m])) * 100)", "legendFormat": "CPU %" },
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }}
    }
  ]
}
