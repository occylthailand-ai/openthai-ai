# หมวด 6 + 9 — Peppol Gateway Container
FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2-dev libxslt1-dev \
    softhsm2 opensc \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY peppol/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code
COPY peppol/ ./peppol/
COPY src/xades_engine/ ./src/xades_engine/

# Certs directory (mount from volume)
RUN mkdir -p /certs/services

EXPOSE 8001

CMD ["uvicorn", "peppol.api_server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
