# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars — it is git-ignored.

aws_region   = "ap-southeast-1"
environment  = "production"

# Replace with your actual VPC and subnet IDs
vpc_id             = "vpc-REPLACE_ME"
private_subnet_ids = ["subnet-REPLACE_ME_1", "subnet-REPLACE_ME_2"]
eks_cluster_name   = "openthaiai-cluster"
eks_cluster_cidr   = "10.0.0.0/16"

# Redis
redis_node_type      = "cache.t4g.small"
redis_engine_version = "7.1"

# Worker
worker_namespace       = "openthaiai"
worker_deployment_name = "arbitrage-worker"

# Versions
keda_chart_version       = "2.14.0"
prometheus_chart_version = "58.1.3"

# Secrets — set via environment variables instead:
# export TF_VAR_grafana_admin_password="your-password"
# export TF_VAR_slack_webhook_url="https://hooks.slack.com/services/..."
grafana_admin_password = ""
slack_webhook_url      = ""
slack_alert_channel    = "#openthaiai-alerts"
