refreshMetrics()
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    def _json(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _text(self, status, body, ctype="text/plain; charset=utf-8"):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlparse(self.path).path
        if path in ("/", "/preview"):
            return self._text(200, HTML, "text/html; charset=utf-8")
        if path == "/metrics":
            return self._text(200, metrics_text(), "text/plain; version=0.0.4; charset=utf-8")
        return self._json(404, {"ok": False, "error": "not found"})

    def do_POST(self):
        path = urlparse(self.path).path
        raw = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        try:
            body = json.loads(raw.decode("utf-8"))
        except UnicodeDecodeError:
            STATE["counters"]["healer_blocks_total"] += 1
            return self._json(415, {"ok": False, "error": "non-UTF-8 request body blocked"})
        except json.JSONDecodeError:
            return self._json(400, {"ok": False, "error": "invalid json"})

        if path == "/api/forge":
            return self._json(200, generate_all(body.get("context", {}), body.get("existingPaths", [])))
        if path == "/api/healer":
            return self._json(200, healer_scan(body.get("name", "inline-input"), body.get("text", ""), body.get("mode", "source")))
        if path == "/api/oci":
            STATE["counters"]["oci_validation_total"] += 1
            result = validate_oci(body.get("ref", ""))
            if not result["ok"]:
                STATE["counters"]["oci_reject_total"] += 1
            return self._json(200, result)
        if path == "/api/lock":
            if body.get("tamper"):
                if STATE["ledger"]:
                    STATE["ledger"][0]["prev_hash"] = "tampered"
                    STATE["ledger_frozen"] = True
                    STATE["counters"]["ledger_freeze_total"] += 1
                return self._json(200, {"ok": False, "frozen": True, "entries": STATE["ledger"]})
            if STATE["ledger_frozen"]:
                return self._json(423, {"ok": False, "frozen": True, "error": "ledger frozen"})
            helm_lock, oci_lock, helm_hash, oci_hash, canonical = build_lock(body.get("context", {}))
            append = append_ledger({
                "kind": "lock_bundle",
                "service": body.get("context", {}).get("serviceName", "meta-toolsmith"),
                "canonicalMessage": canonical,
                "helm_lock_sha256": helm_hash,
                "oci_lock_sha256": oci_hash,
            })
            return self._json(200 if append["ok"] else 423, {
                **append,
                "helmLock": helm_lock,
                "ociLock": oci_lock,
                "helmHash": helm_hash,
                "ociHash": oci_hash,
                "canonicalMessage": canonical,
            })
        if path == "/api/g9-preflight":
            return self._json(200, run_g9_preflight(body))
        return self._json(404, {"ok": False, "error": "not found"})


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8080)
    args = parser.parse_args()
    server = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"Meta-Toolsmith ota-preview listening on http://{args.host}:{args.port}/preview")
    server.serve_forever()


if __name__ == "__main__":
    main()
